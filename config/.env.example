# ============================================================
# AutoWPContentPublishWorkflow - 环境变量配置示例
# ============================================================
# 使用方法：
#   cp .env.example .env
#   然后填入你的真实值
#
# WARNING: .env 已被 .gitignore 忽略，绝不会被提交到 GitHub
# ============================================================

# ---------- WordPress 站点配置 ----------
# 站点域名（不带 https:// 和结尾斜杠）
WP_SITE_DOMAIN=your-site.com

# WordPress 管理员用户名
WP_USERNAME=your-wp-user

# WordPress Application Password
# 获取方法：WP 后台 → 用户 → 个人资料 → 勾选"应用程序密码"
# 注意：不要使用管理员登录密码，必须使用 Application Password
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx-xxxx xxxx

# 站点协议
WP_SCHEME=https

# ---------- AI 内容生成配置 ----------
# MiniMax API Key（从 platform.minimaxi.com 获取）
MINIMAX_API_KEY=replace-with-your-minimax-api-key
# 使用的模型
MINIMAX_MODEL=MiniMax-M2.7

# API 端点（国内版用 minimaxi.com，国际版用 minimax.io）
MINIMAX_API_BASE=https://api.minimaxi.com/v1

# ---------- 内容质量配置 ----------
# 文章最小词数（低于此值触发重写）
MIN_WORDS=1500

# 文章目标词数区间
TARGET_WORDS_MIN=1600
TARGET_WORDS_MAX=1800

# 主内容生成 max_tokens
MAX_TOKENS_CONTENT=6144
# H2 重写 max_tokens
MAX_TOKENS_H2_REWRITE=3000

# ---------- 内部链接配置 ----------
# 每篇文章最少内链数
MIN_INTERNAL_LINKS=3

# 推荐的每篇文章内链数
RECOMMENDED_INTERNAL_LINKS=5

# ---------- 站点信息 ----------
# 站点名称（用于 SEO title 后缀）
SITE_NAME=Your AI Tools Site

# ---------- 代理配置（可选）----------
# macOS 系统代理下 Python 不会自动读取，需要显式设置
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
